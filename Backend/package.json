{
  "name": "hrms-backend",
  "version": "1.0.0",
  "description": "HRMS Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint . --ext .js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "db:setup": "node database/setup.js",
    "db:schema": "node -e \"import('./database/setup.js').then(() => console.log('Schema loaded'))\""
  },
  "keywords": ["hrms", "api", "express"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pdfkit": "^0.13.0",
    "exceljs": "^4.4.0",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.11"
  }
}
